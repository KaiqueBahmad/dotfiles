#!/bin/bash

# AI Commit Message Generator using DeepSeek API
# Usage: ./generate-commit.sh
# Requirements: Set DEEPSEEK_API_KEY environment variable

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    print_error "Not in a git repository!"
    exit 1
fi

# Check if DEEPSEEK_API_KEY is set
if [ -z "$DEEPSEEK_API_KEY" ]; then
    print_error "DEEPSEEK_API_KEY environment variable is not set!"
    echo "Please set it with: export DEEPSEEK_API_KEY='your-api-key'"
    exit 1
fi

# Get staged changes
print_info "Getting staged changes..."
DIFF_OUTPUT=$(git diff --cached)

# Check if there are any staged changes
if [ -z "$DIFF_OUTPUT" ]; then
    print_warning "No staged changes found!"
    echo "Please stage some changes first with: git add <files>"
    exit 1
fi

# Check if diff is too large (DeepSeek has context limits)
DIFF_LENGTH=${#DIFF_OUTPUT}
if [ $DIFF_LENGTH -gt 15000 ]; then
    print_warning "Diff is quite large ($DIFF_LENGTH chars). Truncating for API call..."
    DIFF_OUTPUT=$(echo "$DIFF_OUTPUT" | head -c 15000)
fi

print_info "Generating commit message with DeepSeek AI..."

# Prepare the prompt for DeepSeek API
PROMPT="Based on the following git diff of staged changes, generate a concise and descriptive commit message following conventional commit format (type(scope): description).

Use these guidelines:
- Use present tense (\"add\" not \"added\")
- Keep the first line under 50 characters
- Use conventional commit types: feat, fix, docs, style, refactor, test, chore
- Include scope when relevant (e.g., auth, ui, api)
- Be specific about what changed
- Write in Brazilian portuguese
Git diff:
\`\`\`
$DIFF_OUTPUT
\`\`\`

Respond with only the commit message, no additional text or explanation."

# Make API call to DeepSeek
RESPONSE=$(curl -s -X POST "https://api.deepseek.com/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $DEEPSEEK_API_KEY" \
    -d "{
        \"model\": \"deepseek-chat\",
        \"messages\": [
            {
                \"role\": \"user\",
                \"content\": $(echo "$PROMPT" | jq -R -s .)
            }
        ],
        \"max_tokens\": 100,
        \"temperature\": 0.3
    }")

# Check if API call was successful
if [ $? -ne 0 ]; then
    print_error "Failed to call DeepSeek API"
    exit 1
fi

# Extract commit message from response
COMMIT_MESSAGE=$(echo "$RESPONSE" | jq -r '.choices[0].message.content // empty' 2>/dev/null)

# Check if we got a valid response
if [ -z "$COMMIT_MESSAGE" ] || [ "$COMMIT_MESSAGE" = "null" ]; then
    print_error "Failed to generate commit message"
    echo "API Response: $RESPONSE"
    exit 1
fi

# Clean up the commit message (remove quotes and extra whitespace)
COMMIT_MESSAGE=$(echo "$COMMIT_MESSAGE" | sed 's/^["'\'']*//;s/["'\'']*$//' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
# Display the generated commit message
echo ""
print_success "Generated commit message:"
echo -e "${GREEN}${COMMIT_MESSAGE}${NC}"
echo ""

# Ask user if they want to use this message
read -p "Do you want to commit with this message? [Y/n]: " -n 1 -r
echo ""

if [[ $REPLY =~ ^[Yy]$ ]] || [[ -z $REPLY ]]; then
    # Commit with the generated message
    git commit -m "$COMMIT_MESSAGE"
    print_success "Changes committed successfully!"
else
    print_info "Commit cancelled. You can manually commit with:"
    echo "git commit -m \"$COMMIT_MESSAGE\""
fi
