#!/bin/bash

# Discord Update Script - .deb installer
# Downloads and installs Discord from official .deb package

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Discord Update Script${NC}"
echo "================================"

# Check if wget is installed
if ! command -v wget &> /dev/null; then
    echo -e "${YELLOW}wget not found, installing...${NC}"
    sudo apt update && sudo apt install wget -y
fi

# Create temporary directory
TEMP_DIR=$(mktemp -d)
echo -e "${YELLOW}Downloading Discord...${NC}"

# Download Discord .deb
wget -O "$TEMP_DIR/discord.deb" "https://discord.com/api/download/stable?platform=linux&format=deb"

# Check if download was successful
if [ ! -f "$TEMP_DIR/discord.deb" ]; then
    echo -e "${RED}Download failed!${NC}"
    rm -rf "$TEMP_DIR"
    exit 1
fi

echo -e "${YELLOW}Installing Discord...${NC}"

# Install the .deb package (requires sudo)
sudo dpkg -i "$TEMP_DIR/discord.deb"

# Fix any dependency issues
sudo apt-get install -f -y

# Cleanup
rm -rf "$TEMP_DIR"

echo -e "${GREEN}Discord has been updated successfully!${NC}"
echo "You may need to restart Discord if it's currently running."
